{
  "name": "davinci-desktop",
  "productName": "DaVinci",
  "version": "1.0.0",
  "private": true,
  "description": "DaVinci desktop app (Electron wrapper around the static web app)",
  "author": "joshuamontierth",
  "license": "UNLICENSED",
  "main": "main.js",
  "desktopName": "davinci.desktop",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "stage": "node prepare.mjs",
    "start": "node start.mjs",
    "pack": "node prepare.mjs && electron-builder --dir --publish never",
    "dist": "node prepare.mjs && electron-builder --publish never",
    "dist:linux": "node prepare.mjs && electron-builder --linux --publish never",
    "dist:win": "node prepare.mjs && electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.joshuamontierth.davinci",
    "productName": "DaVinci",
    "copyright": "Copyright (c) 2026 joshuamontierth",
    "asar": true,
    "directories": {
      "output": "../dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "bundle/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "icon": "../installer/icons",
      "category": "Graphics",
      "synopsis": "Pen-plotter G-code generator",
      "executableName": "davinci",
      "syncDesktopName": true,
      "artifactName": "davinci-${version}-linux-${arch}.${ext}"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "../installer/icons/davinci.ico"
    },
    "portable": {
      "artifactName": "davinci-${version}-win-${arch}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "davinci-${version}-win-${arch}-setup.${ext}"
    },
    "fileAssociations": [
      {
        "ext": "davinci",
        "name": "DaVinci project",
        "description": "DaVinci project",
        "mimeType": "application/x-davinci",
        "role": "Editor"
      }
    ]
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "allowScripts": {
    "electron-winstaller": false
  }
}
