{
  "name": "davinci-desktop",
  "productName": "DaVinci",
  "version": "2.0.1",
  "private": true,
  "description": "DaVinci desktop app (Electron wrapper around the static web app)",
  "author": "joshuamontierth",
  "homepage": "https://github.com/joshuamontierth/DaVinci-pen-plotter",
  "license": "UNLICENSED",
  "main": "main.js",
  "desktopName": "davinci.desktop",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "stage": "node prepare.mjs",
    "start": "node start.mjs",
    "pack": "node prepare.mjs && electron-builder --dir --config ../installer/electron-builder.config.cjs --publish never",
    "dist": "node prepare.mjs && electron-builder --config ../installer/electron-builder.config.cjs --publish never",
    "dist:linux": "node prepare.mjs && electron-builder --linux --config ../installer/electron-builder.config.cjs --publish never",
    "dist:win": "node prepare.mjs && electron-builder --win --config ../installer/electron-builder.config.cjs --publish never"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "allowScripts": {
    "electron-winstaller": false
  }
}
